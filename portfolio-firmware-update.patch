+const ACTS = [
+  {
+    no: 'Act I', when: '2021 – 2022', where: 'VIRENTO · startup competition',
+    title: 'Learning what engineering practice actually is',
+    lede: "Led three engineers on VIRENTO, a peer rental marketplace, and got my first real lesson in why practice matters, not just code that runs.",
+    takeaway: "Distance is a design choice. I think about data locality now because I once didn't.",
+  },
+  {
+    no: 'Act II', when: 'Mid 2022', where: 'Forget me Not · Android app for dementia patients',
+    title: 'Where purpose clicked',
+    lede: "A course assignment: build a mobile app for people living with dementia, so they could reach the people they love.",
+    takeaway: "Building an actual solution to somebody's actual problem is the part I'm in this for.",
+  },
+  {
+    no: 'Act III', when: 'Sep 2022 – Dec 2023', where: 'Atimi Software · Vancouver',
+    title: "Sitting with people's problems, then proposing a fix",
+    lede: "I proposed a template email to my manager to save people repeating themselves on HR on/offboarding — it grew into full automation covering over 100 employees.",
+    takeaway: "Sitting with the person who has the problem is the fastest requirements gathering there is.",
+  },
+  {
+    no: 'Act IV', when: 'Jan 2024 – present', where: 'SFU BluePrint · non-profit collaborations',
+    title: 'Discipline, at team scale',
+    lede: "Volunteering on a strong, dynamic team — shipping to real people, against a real deadline, while the design kept evolving.",
+    takeaway: "It just felt wrong to ship something volunteers rely on without a gate in front of it.",
+  },
+  {
+    no: 'Act V', when: 'May – Aug 2024', where: 'Parabix · faculty project',
+    title: 'The curiosity that pointed me at firmware',
+    lede: "Compiled C++ to NVIDIA PTX assembly through LLVM — word counting is boring at the top, not boring at all at the instruction level.",
+    takeaway: "That gap is what made me realise firmware — the layer closest to the mechanism — was what I wanted to chase.",
+  },
+  {
+    no: 'Act VI', when: 'Jan 2025 – present', where: 'SFU Robot Soccer',
+    title: 'Solving real problems in firmware',
+    lede: "Brought up SPI/IMU integration and refactored firmware to simulate on a host, enabling CI on every commit.",
+    takeaway: "That extra layer of continuous checking is what let the team trust the control loop under competition pressure.",
+  },
+  {
+    no: 'Act VII', when: 'Jan – Aug 2025', where: 'Schneider Electric · Richmond, BC',
+    title: 'Bridging code and physical machines',
+    lede: "A firmware co-op on solar/battery inverters — real product, real safety expectations.",
+    takeaway: "Some problems just aren't reachable from inside software, and I'd rather go learn that side than pretend otherwise.",
+  },
+  {
+    no: 'Act VIII', when: 'Jan 2026 – now', where: 'risc-v-logism · personal research',
+    title: 'What hardware verification taught me about AI',
+    lede: "Building a RISC-V CPU raised a question testing couldn't answer, which led to formal verification and Dafny.",
+    takeaway: "The same machinery that proves a circuit right is the machinery I'd want for checking code an AI model wrote.",
+  },
+];
+
+export default function Story() {
+  return (
+    <section className="max-w-page mx-auto px-5 py-[calc(80px*var(--density))]" id="story">
+      <div className="section-label font-mono text-xs text-fg-4 tracking-[0.04em] uppercase flex items-center gap-2.5 mb-6">§ how I got here</div>
+      <h2 className="section-title font-medium tracking-[-0.025em] leading-[1.1] max-w-[760px] mb-10">From software to firmware.</h2>
+      <div className="flex flex-col gap-12">
+        {ACTS.map(act => (
+          <div key={act.no} className="grid grid-cols-1 md:grid-cols-[176px_1fr] gap-6 md:gap-10 items-start pl-4 border-l border-border">
+            <div>
+              <div className="font-mono text-2xs tracking-[0.1em] uppercase text-accent">{act.no}</div>
+              <div className="font-mono text-xs text-fg-4 mt-1">{act.when}</div>
+              <div className="text-sm text-fg-3 mt-3">{act.where}</div>
+            </div>
+            <div>
+              <h3 className="text-2xl mb-3 tracking-[-0.02em]">{act.title}</h3>
+              <p className="text-fg-2 leading-[1.6] mb-3 max-w-[62ch]">{act.lede}</p>
+              <div className="text-fg-2 leading-[1.6] max-w-[60ch] pt-3 border-t border-border">
+                <span className="text-accent">What it changed:</span> {act.takeaway}
+              </div>
+            </div>
+          </div>
+        ))}
+      </div>
+    </section>
+  );
+}
